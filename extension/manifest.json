{
  "manifest_version": 3,
  "name": "DropCheck",
  "version": "0.4.0",
  "minimum_chrome_version": "111",
  "description": "Flags dropshipping signals on Swedish and Norwegian online stores and explains each one. Observations, not accusations.",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "permissions": ["storage", "activeTab", "scripting", "alarms"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background/worker.js", "type": "module" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DropCheck",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  }
}
