{
  "name": "dropcheck",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that flags dropshipping signals on Swedish and Norwegian online stores.",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "eval": "node eval/run.js",
    "icons": "node scripts/render-icons.js",
    "sync-faq": "node scripts/sync-faq.js",
    "store-screenshots": "node scripts/store-screenshots.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "puppeteer": "^25.18.1",
    "typescript": "^7.0.2"
  }
}
